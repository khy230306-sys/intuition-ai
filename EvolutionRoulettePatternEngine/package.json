{
  "name": "evolution-roulette-pattern-engine",
  "version": "1.0.0",
  "description": "Evolution Roulette Pattern Engine V1 — pattern detection, betting state machine, martingale, replay",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "roulette-pattern-engine": "dist/server/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "tsx src/cli/replay.ts",
    "package:portable": "npm run build && node scripts/package-portable.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "roulette",
    "pattern-engine",
    "evolution"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "nanoid": "^5.1.5",
    "playwright": "^1.51.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
