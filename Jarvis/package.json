{
  "name": "aizio-iphone",
  "private": true,
  "version": "1.33.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "quotes": "node scripts/fetch-quotes.mjs",
    "build": "node scripts/fetch-quotes.mjs && node scripts/fetch-news.mjs && tsc && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "deploy:web": "node scripts/deploy-fixed.mjs",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "deploy:web:anon": "echo 'Do not use anon deploy — it creates a new random URL. Use npm run deploy:web for https://jarvis-app.shipstatic.com' && exit 1",
    "push-server": "node push-server/server.mjs",
    "test": "vitest run",
    "test:voice": "npm run build && node scripts/voice-e2e.mjs",
    "test:practical": "npm run build && node scripts/practical-e2e.mjs",
    "test:share": "npm run build && node scripts/share-home-e2e.mjs",
    "test:family": "npm run build && node scripts/family-e2e.mjs",
    "test:friends": "npm run build && node scripts/friends-e2e.mjs",
    "test:invite": "npm run build && node scripts/invite-join-e2e.mjs",
    "test:invite-copy": "npm run build && node scripts/invite-copy-e2e.mjs",
    "test:api-keys": "vitest run src/apiKeys src/ai-providers/hybridAi.test.ts && node --test push-server/secretsStore.test.mjs && node scripts/api-key-e2e.mjs",
    "test:final-qa": "npm run build && node scripts/final-qa-e2e.mjs"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/qrcode": "^1.5.6",
    "puppeteer-core": "^24.22.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@huggingface/transformers": "^4.2.0",
    "@trystero-p2p/mqtt": "^0.25.3",
    "jsqr": "^1.4.0",
    "maplibre-gl": "^4.7.1",
    "mqtt": "^5.15.2",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  }
}
