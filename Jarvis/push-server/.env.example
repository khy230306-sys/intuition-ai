# Copy to .env locally — never commit real secrets.
PORT=8787
NODE_ENV=production

# Generate: node -e "import('web-push').then(w=>console.log(w.default.generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Comma-separated Origins (no trailing slash). Include REVIEW + production + local.
ALLOWED_ORIGINS=https://harmonic-rift-5oo4f3w.shipstatic.com,https://jarvis-app.shipstatic.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

DATA_DIR=./data
CRON_SECRET=
# Optional shared secret for mutating APIs (header X-AIZIO-Install). Empty = open (preview only).
INSTALL_TOKEN=
RATE_LIMIT_PER_MIN=120

# Optional app-owned AI (server Secret Store). Never commit real values.
# GEMINI_API_KEY=
# AIZIO_GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
