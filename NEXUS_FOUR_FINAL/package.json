{
  "name": "nexus-four-final",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -k -n vite,electron \"npm run dev -- --host\" \"npm run electron:run\"",
    "electron:run": "cross-env ELECTRON_DEV=1 electron .",
    "electron:build": "npm run build && electron-builder --win"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "classnames": "^2.5.1",
    "dexie": "^4.4.4",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite-plugin-pwa": "^1.3.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.nexusfourfinal.app",
    "productName": "NEXUS FOUR FINAL",
    "files": [
      "dist-electron/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      "docs/**/*",
      "public/**/*",
      "scanner/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
