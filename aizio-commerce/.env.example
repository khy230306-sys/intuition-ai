# AIZIO COMMERCE — copy to .env and fill only what you have.
# Missing keys keep the related adapter in PENDING_SETUP / NOT_CONFIGURED.
# Never commit real secrets.

PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/aizio-commerce.sqlite
AIZIO_ENCRYPTION_KEY=

# AI providers (Manager AI fallback: OpenAI → Gemini → Claude)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# CJdropshipping — official API 2.0
# Docs: https://developers.cjdropshipping.com/en/api/api2/api/authentication.html
CJ_EMAIL=
CJ_API_PASSWORD=
CJ_ACCESS_TOKEN=

# Coupang Wing Open API — HMAC CEA
# Docs: https://developers.coupang.com/en/api
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=

# Naver Commerce API — OAuth2 client credentials + bcrypt signature
# Docs: https://apicenter.commerce.naver.com/docs/auth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
