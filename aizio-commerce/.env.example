# AIZIO COMMERCE — copy to .env and fill only what you have.
# Missing keys keep the related adapter in PENDING_SETUP / NOT_CONFIGURED.
# Never commit real secrets.

PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/aizio-commerce.sqlite
AIZIO_ENCRYPTION_KEY=

# AI providers (Manager AI fallback: OpenAI → Gemini → Claude)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# CJdropshipping — official API 2.0 (2026)
# Auth docs: https://developers.cjdropshipping.cn/en/api/api2/api/auth.html
# POST /authentication/getAccessToken  body: { "apiKey": "..." }
# Header on later calls: CJ-Access-Token
# Issue key: My CJ → Apps → install API → Authorization/API tab → Add API → Type: API Key
# Do not invent keys. Leave blank until issued. Email is NOT part of the v2 token API.
CJ_API_KEY=
# Optional: paste a token already issued by the official token API (and its refresh token)
CJ_ACCESS_TOKEN=
CJ_REFRESH_TOKEN=
# Unused by official v2 auth. Kept only as a legacy alias for CJ_API_KEY.
CJ_EMAIL=
CJ_API_PASSWORD=

# Coupang Wing Open API — HMAC CEA
# Docs: https://developers.coupang.com/en/api
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=

# Naver Commerce API — OAuth2 client credentials + bcrypt signature
# Docs: https://apicenter.commerce.naver.com/docs/auth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
