# AIZIO TRADE AUTOPILOT V1.1
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8787
WEB_PORT=5177
DATABASE_URL="file:./dev.db"

DEFAULT_MODE=PAPER
DEFAULT_CAPITAL=3000000
HEARTBEAT_MS=8000
WORKER_TICK_MS=3000

# Toss Securities Open API (official v1.2.14)
# https://openapi.tossinvest.com/openapi-docs/latest/openapi.json
# Do NOT commit secrets. Register allowed IP in Toss WTS.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
TOSS_API_BASE_URL=https://openapi.tossinvest.com

# AI provider: none | openai | gemini | openrouter | custom
AI_PROVIDER=none
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_DECISION_AGE_MS=20000
AI_REQUIRED_FOR_ENTRY=true

# Market data: auto | toss | replay
# REPLAY never silently substitutes for LIVE/SHADOW/LIVE_OBSERVE.
MARKET_DATA_PROVIDER=auto
PAPER_SIMULATE_REGULAR_SESSION=false

FRESHNESS_KR_MS=60000
FRESHNESS_US_MS=90000
UNIVERSE_INCLUDE_ETF=false
UNIVERSE_INCLUDE_ETN=false
UNIVERSE_COMMON_SHARE_ONLY=true
SCANNER_BROAD_INTERVAL_MS=60000
SCANNER_WATCH_INTERVAL_MS=5000
UNIVERSE_REFRESH_MS=86400000

# Real orders stay locked until LIVE diagnostics PASS + this flag
ALLOW_LIVE=false
