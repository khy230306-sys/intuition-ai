# AIZIO TRADE AUTOPILOT V1
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8787
WEB_PORT=5177
DATABASE_URL="file:./dev.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://user:pass@localhost:5432/aizio_trade?schema=public"

# Autopilot defaults
DEFAULT_MODE=PAPER
DEFAULT_CAPITAL=3000000
HEARTBEAT_MS=8000
WORKER_TICK_MS=3000

# Toss Securities Open API (official: https://developers.tossinvest.com)
# Do NOT commit real secrets. Register client at Toss WTS > Settings > Open API.
# Also register allowed IPs. Source of truth: https://openapi.tossinvest.com/openapi-docs/latest/openapi.json
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
TOSS_API_BASE_URL=https://openapi.tossinvest.com

# Optional AI provider (OpenAI-compatible). Without this, AI Judge stays NOT_CONFIGURED
# and fail-safe blocks new entries when AI confidence is required.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_TIMEOUT_MS=15000
AI_REQUIRED_FOR_ENTRY=true

# Market data: toss | replay
# replay uses deterministic seeded quotes for PAPER without Toss credentials.
MARKET_DATA_PROVIDER=replay

# PAPER + replay only: simulate KR REGULAR session off-hours for end-to-end paper runs.
PAPER_SIMULATE_REGULAR_SESSION=false

# Live gate — never auto-enable LIVE without diagnostics PASS
ALLOW_LIVE=false
